

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 301 Redirect legacy and temporary URLs to final flat landing page
  RewriteRule ^pro-services/?$ /pro-services/alabama-roofing-marketing.html [R=301,L,QSA]
  RewriteRule ^pro-services/index\.html$ /pro-services/alabama-roofing-marketing.html [R=301,L,QSA]
  RewriteRule ^pro-services/alabama-roofing-marketing/?$ /pro-services/alabama-roofing-marketing.html [R=301,L,QSA]
  RewriteRule ^pro-services/alabama-roofing-marketing/index\.html$ /pro-services/alabama-roofing-marketing.html [R=301,L,QSA]
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php81” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php81___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

